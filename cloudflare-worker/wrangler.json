{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexovant-news",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "../nexovant-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "BACKEND_API_URL": "https://api.nexovant.si",
    "FRONTEND_URL": "https://nexovant.pages.dev",
    "ENABLE_EDGE_CACHE": "true"
  },
  "observability": {
    "enabled": true
  }
}
