# Nexovant AI Engine Configuration
APP_NAME="Nexovant Cognitive Engine"
ENVIRONMENT="production"
DEBUG=false
API_V1_PREFIX="/api/internal/v1"

# Internal Service-to-Service Security Secret
INTERNAL_SERVICE_SECRET="CHANGE_ME_TO_A_SECURE_64_CHAR_HEX_KEY"

# Database Connection (PostgreSQL + pgvector)
DB_HOST="db"
DB_PORT=5432
DB_NAME="nexovant_production"
DB_USER="nexovant_app"
DB_PASSWORD="nexovant_secret"

# Cloudflare R2 Private Bucket Configuration
R2_ENDPOINT_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nexovant-private-storage"

# Router Safeguards & Thresholds
ROUTER_RPM_WARNING_THRESHOLD=0.70
ROUTER_RPM_CRITICAL_THRESHOLD=0.90
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=180
